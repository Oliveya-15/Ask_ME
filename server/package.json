{
  "name": "askme-server",
  "version": "1.0.0",
  "description": "AskMe REST API - Express, Clerk, Neon Postgres, Gemini, Cloudflare Workers AI, Cloudinary",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "test": "node --test"
  },
  "dependencies": {
    "@clerk/express": "^2.1.75",
    "@google/genai": "^2.27.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
